+// Synchronous conservative GC for long-running code (SPARK simulator patch).
+//
+// Pointers can live in three places: the GC heap/root pointers (handled by
+// gc_collect_start, which also scans the pystack), the C shadow stack in linear
+// memory, and WebAssembly locals, which are invisible to a memory scan.  To make
+// the locals visible, mp_js_gc_spill_and_scan() (library.js) starts an Asyncify
+// unwind: every active wasm frame saves its locals into a buffer in linear memory
+// and returns, up to the JS->C entry point.  The entry-point wrapper installed by
+// api.js then calls mp_js_gc_scan_region() on that buffer and immediately rewinds
+// the stack, so execution continues right here, synchronously, without returning
+// to the JS event loop (upstream's emscripten_scan_registers() uses setTimeout and
+// therefore turns every collection into an asynchronous call).
+
+// Conservative scan of stack-like memory that also accepts interior pointers.
+// gc_collect_root() only keeps an object alive if a word points exactly at its
+// first block.  Optimised wasm code may keep only a derived pointer (for example
+// &self->re in re.sub() with a string pattern) in a local, which upstream's
+// scan ignores, so the object can be freed while still in use (found by running
+// the test suite with gc.threshold(0)).  Here a word pointing anywhere into an
+// allocated chain of blocks marks the head of that chain.  This mirrors the
+// alloc-table encoding in py/gc.c (2 bits per block: free/head/tail/mark).
+static void gc_scan_interior(void **ptrs, size_t len) {
+    mp_state_mem_area_t *area = &MP_STATE_MEM(area);
+    uintptr_t pool_start = (uintptr_t)area->gc_pool_start;
+    uintptr_t pool_end = (uintptr_t)area->gc_pool_end;
+    for (size_t i = 0; i < len; ++i) {
+        uintptr_t p = (uintptr_t)ptrs[i];
+        if (p < pool_start || p >= pool_end) {
+            continue;
+        }
+        size_t block = (p - pool_start) / MICROPY_BYTES_PER_GC_BLOCK;
+        #define SPARK_ATB_KIND(b) ((area->gc_alloc_table_start[(b) / 4] >> (2 * ((b) & 3))) & 3)
+        while (block > 0 && SPARK_ATB_KIND(block) == 2 /* AT_TAIL */) {
+            --block;
+        }
+        if (SPARK_ATB_KIND(block) == 1 /* AT_HEAD, not yet marked */) {
+            void *head = (void *)(pool_start + block * MICROPY_BYTES_PER_GC_BLOCK);
+            gc_collect_root(&head, 1);
+        }
+        #undef SPARK_ATB_KIND
+    }
+}
+
+static void gc_scan_func(void *begin, void *end) {
+    gc_scan_interior((void **)begin, (void **)end - (void **)begin);
+}
+
+// Called from JS while the wasm stack is unwound, with the spilled locals.
+void mp_js_gc_scan_region(void *begin, void *end) {
+    gc_scan_interior((void **)begin, ((uintptr_t)end - (uintptr_t)begin) / sizeof(void *));
+}
