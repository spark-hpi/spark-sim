+// run while nested (see below).  So collect before calling out to JS once a
+// quarter of the heap has been allocated since the last collection; nested code
+// then starts with at least that much free memory.  The check is a single
+// comparison, the collection happens at most once per quarter heap of allocations.
+void mp_js_gc_collect_before_js_call(void) {
+    // Not while the heap is locked: that includes a collection in progress (a
+    // finaliser calling JS), which must not be re-entered.
+    if (MP_STATE_MEM(gc_alloc_amount) >= gc_pre_js_call_blocks && !gc_is_locked()) {
+        gc_collect();
+    }
