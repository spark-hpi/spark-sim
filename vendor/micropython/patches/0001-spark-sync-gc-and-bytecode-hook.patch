+    $MPGC: {
+        STATE_NORMAL: 0,
+        STATE_UNWINDING: 1,
+        STATE_REWINDING: 2,
+        state: 0,
+        // Number of active calls through wrapped entry points.
+        depth: 0,
+        // Asyncify data: [current ptr, end ptr] header followed by the buffer.
+        data: 0,
+        size: 0,
+        // Statistics (exposed through api.js as gcStats()).
+        collections: 0,
+        skipped: 0,
+        maxSpill: 0,
+
+        allocate(size) {
+            if (MPGC.data) {
+                _free(MPGC.data);
+            }
+            MPGC.size = size;
+            MPGC.data = _malloc(8 + size);
+            if (!MPGC.data) {
+                throw new Error("MicroPython: cannot allocate GC spill buffer");
+            }
+        },
+
+        // Wrap a wasm export so that GC unwinds triggered inside it are handled.
+        wrap(func) {
+            const wrapped = function (...args) {
+                ++MPGC.depth;
+                try {
+                    let ret = func(...args);
+                    while (MPGC.state === MPGC.STATE_UNWINDING) {
+                        // The stack is fully unwound; scan the spilled locals.
+                        _asyncify_stop_unwind();
+                        MPGC.state = MPGC.STATE_NORMAL;
+                        const begin = MPGC.data + 8;
+                        const end = HEAPU32[MPGC.data >> 2];
